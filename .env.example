# Copie este arquivo para ".env" e ajuste os valores conforme o ambiente.
#
# --- Ambiente LOCAL (localhost) ---
# Basta NAO definir DATABASE_URL. A aplicacao usa SQLite automaticamente
# (arquivo instance/escola_musica.db).
#
# --- Ambiente em NUVEM (producao) ---
# Defina DATABASE_URL apontando para o Postgres do seu provedor.
# Exemplo:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
#
# Obs.: se o provedor fornecer a URL comecando com "postgres://",
# a aplicacao converte automaticamente para "postgresql://".

# Chave secreta usada pelo Flask (defina um valor forte em producao).
SECRET_KEY=chave-secreta-escola-musica

# Descomente e preencha apenas no ambiente de nuvem:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
